# ─── Lexio — local environment variables ────────────────────────────────────
# Copy this file to `.env.local` for local development. In production, set
# the same variables in Vercel → Project Settings → Environment Variables.
# `.env.local` is gitignored — never commit real secrets.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Both are SAFE to expose client-side. Real security comes from Postgres RLS
# policies + SECURITY DEFINER RPCs (see supabase/migrations/001_initial_schema.sql).
#
# Get them from your Supabase project:
#   Dashboard → Project Settings → API → Project URL / Project API keys (anon)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── ElevenLabs (already used for the cloned voice) ─────────────────────────
# See `.env.example` for the full set. Duplicated here so a fresh clone can
# copy this single file to `.env.local` and be running.
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=gwN3hEbGhE9zHBbp2V10
VITE_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
